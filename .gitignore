# Specific Files to ignore
api/install
api/logs/*
api/resources
api/errors/*
nbproject/*
build/*
# *settings.php
.DS_Store
.vscode
validation_data.json

# files generated by the build process
/api/files/*
!/api/files/.gitkeep

# environment files
.env
docker-php-apache/php-apache.env
docker-php-apache/php-apache.env.production

# content of settings.php is autogenerated
www/settings.php

# Mysql Volume
/mysql-data/*
!/mysql-data/.gitkeep

# ignore IDE/hidden/OS cache files
*~
nbproject
nb-configuration.xml
Session.vim
*.tmproj
*.tmproject
tmtags
Thumbs.db
Desktop.ini

# ignore Composer downloads
/vendor/*

# keep some hiddens
!.htaccess
!/.gitignore
!/.travis.yml

# www/settings.php
*.AppleDouble
*.DS_Store
**/*.AppleDouble
.gitsecret/keys/random_seed
!*.secret
random_seed
